# Binary files are stored as regular git blobs (the repository does not use Git LFS:
# the ~1.4 MB of images, fonts and gzipped fixtures stay small, and forks/contributors
# need no LFS setup or bandwidth). Mark them binary so git never diffs or merges them
# as text or rewrites their line endings.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.gz     binary
*.zip    binary
*.pdf    binary

# Generated single-file bundles: one huge line, not worth a text diff.
plugin/code.js           -diff
plugin/ui.html           -diff
plugin-dev/code.js       -diff
plugin-dev/ui.html       -diff
